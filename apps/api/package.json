{
  "name": "@anti-void/api",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=esm --external:fastify --outdir=dist"
  },
  "dependencies": {
    "@anti-void/contracts": "workspace:*",
    "@anti-void/domain": "workspace:*",
    "@fastify/multipart": "^10.1.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
